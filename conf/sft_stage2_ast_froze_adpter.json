{
    "data": {
        "train_shar_dirs": "data/fbank/speechllm_yodas/shar/en2zh_ast",
        "shard_assignment_file": "data/shar/en2zh_ast_shard_assignment_ws8.json",
        "valid_dataset": [
            "data/cuts/dev/granary_yodas_en2zh_sft_dev_repacked.jsonl"
        ],
        "concatenate_cuts": false,
        "enable_musan": false,
        "enable_spec_aug": true,
        "spec_aug_time_warp_factor": 0,
        "spec_aug_num_feature_masks": 2,
        "spec_aug_features_mask_size": 18,
        "spec_aug_num_frame_masks": 2,
        "spec_aug_frames_mask_size": 50,
        "max_duration": 400.0,
        "max_batch_size": 80,
        "num_buckets": 30,
        "lazy_load": true,
        "pad_last_chunk": true,
        "pad_chunk_size": 32,
        "sampler_type": "shar_pool_sampler",
        "mask_lang_prob": 0.5,
        "start_current_time": 0.025,
        "overlap_ratio": 0.9,
        "overlap_threshold": 0.02,
        "decode_chunks": {
            "1": 0.3,
            "2": 0.3,
            "4": 0.3
        },
        "ast_decode_chunks": {
            "1": 0.3,
            "2": 0.3,
            "4": 0.3
        }
    },
    "model": {
        "zipformer": {
            "feature_dim": 80,
            "encoder_dim": "192,256,384,512,384,256",
            "num_encoder_layers": "2,2,3,4,3,2",
            "downsampling_factor": "1,2,4,8,4,2",
            "feedforward_dim": "512,768,1024,1536,1024,768",
            "num_heads": "4,4,4,8,4,4",
            "encoder_unmasked_dim": "192,192,256,256,256,192",
            "query_head_dim": 32,
            "pos_head_dim": 4,
            "value_head_dim": 12,
            "pos_dim": 48,
            "cnn_module_kernel": "31,31,15,15,15,31",
            "path": "pretrained_models/zipformer_base_en/iter-210000-avg-6.pt",
            "finetune": false,
            "chunk_size": 16,
            "left_context_frames": 128,
            "causal": true
        },
        "adapter": {
            "name": "pooling-adapter",
            "input_dim": 512,
            "hidden_dim": 2048,
            "llm_dim": 1024,
            "num_layers": 2,
            "pooling": "cat",
            "pooling_factor": 4,
            "finetune": false,
            "dropout": 0.0
        },
        "llm": {
            "model_name": "pretrained_models/Qwen3-0.6B",
            "enable_lora": false,
            "finetune": true,
            "gradient_checkpointing": true,
            "enable_dropout": true,
            "dropout_rate": 0.05
        }
    },
    "train": {
        "exp_dir": "exp",
        "exp_name": "sft_stage2_ast_50k_froze_adapter",
        "checkpoint_dir_name": "checkpoints",
        "seed": 42,
        "gpus": 8,
        "grad_accumulate_steps": 1,
        "lr_connector": 2e-4,
        "finetune_special_tokens": true,
        "lr_llm": 2e-5,
        "lr_special_tokens": 2e-5,
        "weight_decay": 0.1,
        "weight_decay_connector": 0.01,
        "weight_decay_special_tokens": 0.0,
        "max_steps": 50000,
        "scheduler": {
            "name": "step_cosine",
            "warmup_steps": 1000,
            "min_lr_ratio": 0.05
        },
        "max_token_length": null,
        "val_interval": 4000,
        "save_interval": 20000,
        "log_interval": 50,
        "dataloader_num_workers": 1,
        "val_decode_chunk": 1,
        "ast_val_decode_chunk": 4,
        "prefetch_factor": 2
    }
}